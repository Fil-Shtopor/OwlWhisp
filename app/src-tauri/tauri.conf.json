{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalWisper",
  "version": "0.1.0",
  "identifier": "ai.localwisper.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../frontend"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../frontend"
    },
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "LocalWisper",
        "width": 920,
        "height": 660,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../assets/icons/32x32.png",
      "../../assets/icons/128x128.png",
      "../../assets/icons/icon.ico"
    ],
    "resources": {
      "runtime/*": "runtime/"
    },
    "category": "Productivity",
    "shortDescription": "Local speech-to-text dictation",
    "longDescription": "Offline dictation. Runs speech recognition entirely on your machine, using the NPU or GPU when one is available and the CPU otherwise. No cloud, no telemetry.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": null
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "libwebkit2gtk-4.1-0",
          "libxdo3"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
